#!/usr/bin/env python3
"""Executable entrypoint for the pve-gdrived daemon."""

import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from pve_gdrive.daemon import run_daemon  # noqa: E402

if __name__ == "__main__":
    sys.exit(run_daemon())
